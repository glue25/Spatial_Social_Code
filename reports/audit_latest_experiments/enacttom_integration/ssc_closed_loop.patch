+    def _ground_current_coordination_targets(
+        self, uid: int, current_action: str
+    ) -> List[str]:
+        """Expose only the current scheduled action's entities to one private graph.
+
+        Partial Habitat graphs omit unseen movable objects, so an otherwise
+        valid oracle directive can fail before navigation begins.  This adapter
+        copies the target entity (and, for movable objects, its containment path)
+        from the simulator graph into only the assigned agent's graph.  It does
+        not replace the graph with the globally shared graph.
+        """
+        if (
+            self.get_run_mode() != "standard"
+            or not self.task
+            or not getattr(self.task, "coordination_target_grounding", False)
+        ):
+            return []
+
+        full_graph = getattr(self.env_interface, "full_world_graph", None)
+        private_graph = getattr(self.env_interface, "world_graph", {}).get(uid)
+        if full_graph is None or private_graph is None:
+            return []
+
+        grounded: List[str] = []
+        for entity_name in _coordination_action_entity_names(current_action):
+            grounding_key = (uid, entity_name)
+            if grounding_key in self._coordination_grounded_entities:
+                continue
+            try:
+                full_node = full_graph.get_node_from_name(entity_name)
+            except ValueError:
+                continue
+
+            # get_subgraph adds an object's furniture/room/house ancestry.  For
+            # structural targets already known in almost all private graphs, a
+            # single-node fallback still supplies the executable sim handle.
+            target_subgraph = full_graph.get_subgraph([full_node])
+            if not target_subgraph.has_node(entity_name):
+                from habitat_llm.world_model.graph import Graph
+
+                target_subgraph = Graph()
+                target_subgraph.add_node(full_node)
+            private_graph.merge(target_subgraph, add_only=True)
+            self._coordination_grounded_entities.add(grounding_key)
+            grounded.append(entity_name)
+        return grounded
+
