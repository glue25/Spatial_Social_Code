+def _is_synthetic_remote_effect(mechanic_result: Any) -> bool:
+    """Return whether a mechanic action should bypass physical articulation."""
+    return bool(
+        mechanic_result
+        and getattr(mechanic_result, "applies", False)
+        and any(
+            str(effect).startswith("remote_effect=")
+            for effect in (getattr(mechanic_result, "effects", None) or [])
+        )
+    )
+
+
+def _coordination_action_entity_names(action: str) -> List[str]:
+    """Extract entity identifiers from one frozen scheduler action.
+
+    Place actions contain an object, a relation, and a destination.  Other
+    supported motor actions use their first argument as the entity.  Tokens
+    such as ``None`` and spatial relations are intentionally excluded.
+    """
+    match = re.match(r"\s*(\w+)\[([^\]]*)\]\s*$", action or "")
+    if not match:
+        return []
+    action_name, raw_args = match.groups()
+    args = [part.strip() for part in raw_args.split(",")]
+    if action_name == "Place":
+        indexes = (0, 2)
+    elif action_name in {"Navigate", "Pick", "Open", "Close"}:
+        indexes = (0,)
+    else:
+        return []
+    return [
+        args[index]
+        for index in indexes
+        if index < len(args) and args[index] and args[index] != "None"
+    ]
+
